# Copy to .env to override defaults. Every setting below is read by
# src/credit_risk_model/config.py; relative paths resolve against PROJECT_ROOT, or the
# current working directory when PROJECT_ROOT is unset.

# Environment
ENVIRONMENT=local
LOG_LEVEL=INFO
# PROJECT_ROOT=/path/to/project

# Serving gate. Demo only: lets draft/under_review models and overdue reviews be served.
ALLOW_UNREVIEWED_MODEL=false
CHAMPION_NAME=credit_risk_champion
# Leave empty to use the inventory artifact_path.
MODEL_PATH=
# Optional SHA-256 of the artefact; loading is refused on mismatch.
MODEL_SHA256=

# Paths
GOVERNANCE_DIR=governance
INVENTORY_PATH=governance/model_inventory.yaml
AUDIT_TRAIL_DIR=governance/audit_trail
PMA_REGISTER_PATH=governance/pma_log.csv
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# Monitoring thresholds (single authoritative source)
PSI_INVESTIGATE=0.10
PSI_ESCALATE=0.25
CSI_INVESTIGATE=0.10
CSI_ESCALATE=0.25
AUROC_DROP_INVESTIGATE=0.03
AUROC_DROP_ESCALATE=0.05

# Audit trail
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_PAGE_SIZE=500
# true: a prediction is withheld (503) if its audit record cannot be written.
AUDIT_FAIL_CLOSED=true
# /audit endpoints are disabled unless this is set (Authorization: Bearer <token>).
AUDIT_API_TOKEN=
# If set, /predict requires Authorization: Bearer <token>.
PREDICT_API_TOKEN=
MAX_REQUEST_BYTES=16384

# MLflow (optional, registry extra)
MLFLOW_TRACKING_URI=
