# Environment
ENVIRONMENT=local
ALLOW_UNREVIEWED_MODEL=false
LOG_LEVEL=INFO

# Model artifact (MODEL_PATH overrides the inventory artifact_path)
MODEL_PATH=artifacts/champion.joblib
MODEL_VERSION=local-unregistered

# Paths
GOVERNANCE_DIR=governance
INVENTORY_PATH=governance/model_inventory.yaml
AUDIT_TRAIL_DIR=governance/audit_trail
PMA_LOG_PATH=governance/pma_log.csv
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# Monitoring thresholds
PSI_INVESTIGATE=0.10
PSI_ALERT=0.25
CSI_INVESTIGATE=0.10
CSI_ALERT=0.25
DECISION_THRESHOLD=0.20

# Audit
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_PAGE_SIZE=500

# MLflow (optional)
MLFLOW_TRACKING_URI=
